#!/bin/sh
#
# wguser --  add/remove server config and put client config
#
# require: ip-pool (pypi), wg (wireguard-tools)
#
# Settings are read from a config file (shell syntax, see
# wguser.conf.example), searched in this order:
#   -c FILE / --config FILE,  $WGUSER_CONF,  <script dir>/wguser.conf
# Without a config file the defaults below are used.
#
set -eu
umask 077  # configs contain private keys

PROG=$(basename "$0")
SCRIPTDIR=$(cd "$(dirname "$0")" && pwd)

# load the config file and fill in defaults
load_config() {
  if [ -n "$conffile" ]; then
    [ -f "$conffile" ] || die "config not found: $conffile"
  elif [ -f "$SCRIPTDIR/wguser.conf" ]; then
    conffile="$SCRIPTDIR/wguser.conf"
  fi
  if [ -n "$conffile" ]; then
    case $conffile in */*) ;; *) conffile="./$conffile" ;; esac
    # shellcheck disable=SC1090
    . "$conffile"
  fi

  : "${INTERFACE:=wg0}"
  : "${DATADIR:=${WGUSER_DIR:-$SCRIPTDIR}}"
  : "${DBFILE:=$DATADIR/vpn.json}"
  : "${SERVERINTCONF:=$DATADIR/$INTERFACE.conf}"
  : "${SERVERTMPL:=$DATADIR/servertmpl}"
  : "${CLIENTDIR:=.}"
  : "${HANDSHAKE_TIMEOUT:=180}"

  case $HANDSHAKE_TIMEOUT in
    ''|*[!0-9]*) die "HANDSHAKE_TIMEOUT must be a number of seconds" ;;
  esac
  [ -d "$CLIENTDIR" ] || die "CLIENTDIR not found: $CLIENTDIR"
}

##
##
usage() {
 cat << EOUSAGE
------
Usage $PROG -a username   -- add useraccount
      $PROG -r username   -- remove useraccount
      $PROG -l            -- list user
      $PROG -s, --status  -- show connected accounts and remote IP on $INTERFACE
      $PROG -p, --peers   -- all peers of $INTERFACE as TSV
      $PROG -m, --metrics -- statistics in Prometheus text format
Options:
      -c, --config FILE   -- config file (default: \$WGUSER_CONF or $SCRIPTDIR/wguser.conf)
------
EOUSAGE
}

die() {
  echo "$PROG: $*" >&2
  exit 1
}

check_files() {
  for f in "$DBFILE" "$SERVERINTCONF" "$SERVERTMPL"; do
    [ -f "$f" ] || die "not found: $f"
  done
}

# username is used as a file name and as a marker in the server config
check_username() {
  case $1 in
    ''|-*|*[!A-Za-z0-9_-]*)
      die "invalid username '$1' (allowed: A-Z a-z 0-9 _ -, not starting with -)" ;;
  esac
}

peer_exists() {
  grep -Fqx "## $1" "$SERVERINTCONF"
}

add_user() {
  username=$1
  check_username "$username"
  peer_exists "$username" && die "user '$username' already exists"
  clientconf="${CLIENTDIR}/${username}.conf"
  [ -e "$clientconf" ] && die "$clientconf already exists"

  pkey=$(wg genkey)
  pubkey=$(printf '%s\n' "$pkey" | wg pubkey)
  uip=$(ip-pool --new-address "$username" "$DBFILE")
  [ -n "$uip" ] || die "ip-pool returned no address"
  case $uip in
    *:*) pip="${uip%/*}/128" ;;
    *)   pip="${uip%/*}/32" ;;
  esac

  cat << PCONFIG > "$clientconf"
[Interface]
Address = ${pip}
PrivateKey = ${pkey}

$(cat "$SERVERTMPL")
PCONFIG

  cat << SCONFIG >> "$SERVERINTCONF"

[Peer]
## ${username}
PublicKey = ${pubkey}
AllowedIPs = ${pip}
SCONFIG

  echo "client config: $clientconf"
  ip-pool --list-used "$DBFILE"
}

remove_user() {
  username=$1
  check_username "$username"
  peer_exists "$username" || die "user '$username' not found in $SERVERINTCONF"

  # drop the whole [Peer] section (up to the next section header)
  # that contains the line "## username"
  tmp=$(mktemp "${SERVERINTCONF}.XXXXXX")
  if ! awk -v marker="## $username" '
      function flush(   i) {
        if (!(ispeer && drop))
          for (i = 1; i <= n; i++) print buf[i]
        n = 0; drop = 0
      }
      /^[[:space:]]*\[/ { flush(); ispeer = ($0 ~ /^[[:space:]]*\[Peer\]/) }
      { buf[++n] = $0; if ($0 == marker) drop = 1 }
      END { flush() }
    ' "$SERVERINTCONF" > "$tmp"; then
    rm -f "$tmp"
    die "failed to update $SERVERINTCONF"
  fi
  cp -p "$SERVERINTCONF" "${SERVERINTCONF}.old"
  mv "$tmp" "$SERVERINTCONF"

  ip-pool --release-address "$username" "$DBFILE"
}

# read "wg show <if> dump" on stdin and print one line per peer (TSV):
#   user public-key remote-ip latest-handshake rx-bytes tx-bytes connected loaded
# usernames are taken from the server config ("(unknown)" if not found).
# peers in the server config but not on the interface get loaded=0.
# a peer is "connected" if its latest handshake is within WireGuard's
# session lifetime (HANDSHAKE_TIMEOUT, default 180s).
peer_table() {
  awk -F '\t' -v OFS='\t' -v now="$(date +%s)" -v alive="$HANDSHAKE_TIMEOUT" '
    # 1st file: server config -> map PublicKey to "## username"
    FNR == NR {
      if ($0 ~ /^[[:space:]]*\[/) name = ""
      else if ($0 ~ /^## /) name = substr($0, 4)
      else if (name != "" && $0 ~ /^[[:space:]]*PublicKey[[:space:]]*=/) {
        k = $0; sub(/^[^=]*=[[:space:]]*/, "", k); sub(/[[:space:]]+$/, "", k)
        user[k] = name; order[++nu] = k
      }
      next
    }
    FNR == 1 { next }  # interface line
    {
      seen[$1] = 1
      ip = $3
      if (ip == "(none)") ip = "-"
      else {
        sub(/:[0-9]+$/, "", ip)   # strip port
        gsub(/[][]/, "", ip)      # [v6addr] -> v6addr
      }
      conn = ($5 > 0 && now - $5 <= alive) ? 1 : 0
      print (($1 in user) ? user[$1] : "(unknown)"), $1, ip, $5, $6, $7, conn, 1
    }
    END {
      for (i = 1; i <= nu; i++)
        if (!(order[i] in seen))
          print user[order[i]], order[i], "-", 0, 0, 0, 0, 0
    }
  ' "$SERVERINTCONF" -
}

wg_dump() {
  wg show "$INTERFACE" dump
}

# connected accounts and their remote IP
show_status() {
  dump=$(wg_dump) || die "cannot read interface $INTERFACE (is it up? are you root?)"
  printf '%-16s %s\n' "ACCOUNT" "REMOTE-IP"
  printf '%s\n' "$dump" | peer_table \
    | awk -F '\t' '$7 == 1 { printf "%-16s %s\n", $1, $3 }'
}

# all peers as TSV (see peer_table), for scripts and the munin plugin
show_peers() {
  dump=$(wg_dump) || die "cannot read interface $INTERFACE (is it up? are you root?)"
  printf '%s\n' "$dump" | peer_table
}

# Prometheus text format, e.g. for node_exporter's textfile collector
show_metrics() {
  if ! dump=$(wg_dump 2>/dev/null); then
    printf '# HELP wguser_interface_up 1 if the WireGuard interface could be read.\n'
    printf '# TYPE wguser_interface_up gauge\n'
    printf 'wguser_interface_up{interface="%s"} 0\n' "$INTERFACE"
    return
  fi
  printf '%s\n' "$dump" | peer_table \
    | awk -F '\t' -v ifname="$INTERFACE" -v alive="$HANDSHAKE_TIMEOUT" '
    function m(name, v) {
      out[name] = out[name] sprintf("%s{interface=\"%s\",user=\"%s\",public_key=\"%s\"} %s\n",
                                    name, ifname, $1, $2, v)
    }
    $8 == 1 {
      m("wguser_peer_receive_bytes_total", $5)
      m("wguser_peer_transmit_bytes_total", $6)
      m("wguser_peer_latest_handshake_timestamp_seconds", $4)
      m("wguser_peer_connected", $7)
      conn += $7
    }
    END {
      help["wguser_peer_receive_bytes_total"] = "counter Bytes received from the peer."
      help["wguser_peer_transmit_bytes_total"] = "counter Bytes sent to the peer."
      help["wguser_peer_latest_handshake_timestamp_seconds"] = "gauge Unix time of the latest handshake (0 = never)."
      help["wguser_peer_connected"] = "gauge 1 if the latest handshake is within " alive "s."
      print "# HELP wguser_interface_up 1 if the WireGuard interface could be read."
      print "# TYPE wguser_interface_up gauge"
      printf "wguser_interface_up{interface=\"%s\"} 1\n", ifname
      print "# HELP wguser_connected_peers Number of connected peers."
      print "# TYPE wguser_connected_peers gauge"
      printf "wguser_connected_peers{interface=\"%s\"} %d\n", ifname, conn
      split("wguser_peer_receive_bytes_total wguser_peer_transmit_bytes_total " \
            "wguser_peer_latest_handshake_timestamp_seconds wguser_peer_connected", names, " ")
      for (i = 1; i in names; i++) {
        n = names[i]
        if (!(n in out)) continue
        t = help[n]; sub(/ .*/, "", t); h = help[n]; sub(/^[^ ]* /, "", h)
        printf "# HELP %s %s\n# TYPE %s %s\n%s", n, h, n, t, out[n]
      }
    }
  '
}

##

# config file option and long options -> short options
conffile=${WGUSER_CONF:-}
want_conf=
for arg; do
  shift
  if [ -n "$want_conf" ]; then
    conffile=$arg; want_conf=
    continue
  fi
  case $arg in
    -c|--config) want_conf=1 ;;
    --config=*)  conffile=${arg#--config=} ;;
    --status)  set -- "$@" -s ;;
    --peers)   set -- "$@" -p ;;
    --metrics) set -- "$@" -m ;;
    *)        set -- "$@" "$arg" ;;
  esac
done
[ -z "$want_conf" ] || die "option -c requires a config file"

load_config
[ $# -gt 0 ] || { usage; exit 1; }
check_files

while getopts a:r:lspm opts
  do
    case $opts in
       a) add_user "$OPTARG" ;;
       r) remove_user "$OPTARG" ;;
       l) ip-pool --list-used "$DBFILE" ;;
       s) show_status ;;
       p) show_peers ;;
       m) show_metrics ;;
       *) usage; exit 1 ;;
    esac
done
